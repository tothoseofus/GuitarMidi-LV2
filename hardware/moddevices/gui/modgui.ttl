@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .

<http://github.com/geraldmwangi/GuitarMidi-LV2-legacy>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-guitarmidi.html> ;
        modgui:stylesheet <modgui/stylesheet-guitarmidi.css> ;
        modgui:screenshot <modgui/screenshot-guitarmidi.png> ;
        modgui:thumbnail <modgui/thumbnail-guitarmidi.png> ;
        modgui:brand "GuitarMidi" ;
        modgui:label "Guitar MIDI" ;
        modgui:port [ lv2:index 0 ; lv2:symbol "gain" ; lv2:name "Input Gain" ] ,
        [ lv2:index 1 ; lv2:symbol "expressivity" ; lv2:name "Expressivity" ] ,
        [ lv2:index 2 ; lv2:symbol "onsetsmoothing" ; lv2:name "Onset Smoothing" ] ,
        [ lv2:index 3 ; lv2:symbol "onsetconfthr" ; lv2:name "Onset Confidence" ] ,
        [ lv2:index 4 ; lv2:symbol "onsetenthr" ; lv2:name "Onset Energy" ] ,
        [ lv2:index 5 ; lv2:symbol "offsetsmoothing" ; lv2:name "Offset Smoothing" ] ,
        [ lv2:index 6 ; lv2:symbol "offsetconfthr" ; lv2:name "Offset Confidence" ] ,
        [ lv2:index 7 ; lv2:symbol "offsetenthr" ; lv2:name "Offset Energy" ]
    ] .
